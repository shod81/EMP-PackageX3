# Store text normalized (LF in the repository), check out per extension.
* text=auto

# Setup.inf fixtures: CRLF is part of the roundtrip contract, never normalize it.
*.inf   text eol=crlf
*.ini   text eol=crlf
*.reg   text eol=crlf

# Windows scripts and spec files keep CRLF.
*.ps1   text eol=crlf
*.bat   text eol=crlf

# Binary assets
*.ico  binary
*.png  binary
*.pdf  binary
*.exe  binary
